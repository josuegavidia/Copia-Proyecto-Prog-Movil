# ==========================================
# NBA Squad Builder - Environment Variables
# ==========================================
# Copia este archivo como .env y coloca tus credenciales reales.
# NUNCA subas el archivo .env con claves reales a Git/GitHub.

# Supabase Cloud Configuration
# Obtén estas credenciales en: https://supabase.com/dashboard/project/_/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-de-supabase-aqui

# Remove.bg API Key (Opcional - para recortar fotos de entrenadores)
# Obtén tu API key en: https://www.remove.bg/api
EXPO_PUBLIC_REMOVE_BG_KEY=tu-remove-bg-api-key-aqui
